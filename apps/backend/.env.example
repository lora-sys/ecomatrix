ECOMATRIX_HTTP_ADDR=:8080
ECOMATRIX_DB_DSN=postgres://repotwin:repotwin@localhost:5432/ecomatrix?sslmode=disable
ECOMATRIX_ADMIN_TOKEN=dev-admin-token
ECOMATRIX_LOG_LEVEL=info
ECOMATRIX_WS_HUB_BUFFER=64
ECOMATRIX_WS_HEARTBEAT_SECONDS=20

# CORS allowlist (comma-separated). "*" = wildcard. Unset + ECOMATRIX_DEV=false = no CORS.
ECOMATRIX_CORS_ALLOWED_ORIGINS=
ECOMATRIX_DEV=true

# Per-agent HMAC secrets (optional; if unset the HMAC middleware is a no-op).
# Format: comma-separated string_id=secret pairs.
ECOMATRIX_AGENT_SECRETS=
